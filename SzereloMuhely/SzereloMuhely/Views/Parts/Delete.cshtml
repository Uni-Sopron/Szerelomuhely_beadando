@model SzereloMuhely.Models.Part

@{
    ViewData["Title"] = "Törlés";
}

<h1>Törlés</h1>
<hr />

<div class="d-flex flex-column align-items-center">
    <h4>Alkatrész</h4>
    <dl class="row text-center">
        <dt class = "col-sm-6">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-6">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-6">
            @Html.DisplayNameFor(model => model.Quantity)
        </dt>
        <dd class = "col-sm-6">
            @Html.DisplayFor(model => model.Quantity)
        </dd>
        <dt class = "col-sm-6">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class = "col-sm-6">
            @Model.Price.ToString("C0")
        </dd>
        <dt class = "col-sm-6">
            @Html.DisplayNameFor(model => model.WorkProcess)
        </dt>
        <dd class = "col-sm-6">
            @Html.DisplayFor(model => model.WorkProcess.Name)
        </dd>
    </dl>
    
    <form asp-action="Delete" class="d-flex gap-5 align-items-center">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Törlés" class="btn btn-danger" />
    </form>
</div>
<a asp-action="Index">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
    </svg>
</a>
