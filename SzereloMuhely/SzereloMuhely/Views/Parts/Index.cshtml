@model IEnumerable<SzereloMuhely.Models.Part>

@{
    ViewData["Title"] = "Alkatrészek";
}

<h1>Alkatrész</h1>

<p>
    <a asp-action="Create">Új hozzáadása</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkProcess)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WorkProcess.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ID">Módosítás</a> |
                <a asp-action="Details" asp-route-id="@item.ID">Részletek</a> |
                <a asp-action="Delete" asp-route-id="@item.ID">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
