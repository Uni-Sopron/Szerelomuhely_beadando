@model SzereloMuhely.Models.WorkSheet

@{
    ViewData["Title"] =  $"Munkalap_{Model.ID}_{Model.Vehicle?.LicensePlate}_{Model.Title}";
}


<h1>Részletek</h1>
<hr />
<div class="d-flex flex-column align-items-center" id="print-area">
    <h4>Munkalap</h4>
    <dl class="row text-center">
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-3">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.CreatedAt)
        </dt>
        <dd class="col-sm-3">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.ID)
        </dt>
        <dd class="col-sm-3">
            @Html.DisplayFor(model => model.ID)
        </dd>
        @if (!@Model.IsOpen) {
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.PaymentMethod)
        </dt>
        <dd class = "col-sm-3">
            @Html.DisplayFor(model => model.PaymentMethod)
        </dd>
        }
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.Recruiter)
        </dt>
        <dd class = "col-sm-3">
            @Html.DisplayFor(model => model.Recruiter.UserName) 
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Mechanic)
        </dt>
        <dd class="col-sm-3">
            @Html.DisplayFor(model => model.Mechanic.UserName)
        </dd>
    </dl>

    @if (Model.Vehicle != null)
    {
    <hr />
    <h4>Jármű</h4>
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Vehicle.LicensePlate)</th>
                <th>@Html.DisplayNameFor(model => model.Vehicle.Make)</th>
                <th>@Html.DisplayNameFor(model => model.Vehicle.Model)</th>
                <th>@Html.DisplayNameFor(model => model.Vehicle.OwnerName)</th>
                <th>@Html.DisplayNameFor(model => model.Vehicle.OwnerAddress)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Html.DisplayFor(model => model.Vehicle.LicensePlate)</td>
                <td>@Html.DisplayFor(model => model.Vehicle.Make)</td>
                <td>@Html.DisplayFor(model => model.Vehicle.Model)</td>
                <td>@Html.DisplayFor(model => model.Vehicle.OwnerName)</td>
                <td>@Html.DisplayFor(model => model.Vehicle.OwnerAddress)</td>
            </tr>
        </tbody>
    </table>
    }

    @if (Model.WorkProcesses.Any())
    {
    <hr />
    <h4>Munkafolyamatok</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Megnevezés</th>
                <th>Munkadíj</th>
                <th>Anyag + Alkatrész</th>
                <th>Munkaóra</th>
                <th>Összesen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wp in Model.WorkProcesses)
            {
                <tr>
                    <td>@wp.Name</td>
                    <td>@wp.Price.ToString("C0")</td>
                    <td>
                        @((wp.Materials.Sum(m => m.Price * m.Quantity) +
                           wp.Parts.Sum(p => p.Price * p.Quantity)).ToString("C0"))
                    </td>
                    <td>@wp.Duration</td>
                    <td><strong>@((wp.Price + wp.Materials.Sum(m => m.Price * m.Quantity) + wp.Parts.Sum(p => p.Price * p.Quantity)).ToString("C0"))</strong></td>
                </tr>
            }
        </tbody>
    </table>
    }

    @if (Model.WorkProcesses.Any(wp => wp.Parts.Any()))
    {
    <hr />
    <h4>Alkatrészek</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Megnevezés</th>
                <th>Mennyiség</th>
                <th>Egységár</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wp in Model.WorkProcesses)
            {
                @foreach ( var p in wp.Parts)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.Quantity</td>
                        <td>@p.Price</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    }

    @if (Model.WorkProcesses.Any(wp => wp.Materials.Any()))
    {
     <hr />
     <h4>Anyagok</h4>
     <table class="table">
         <thead>
             <tr>
             <th>Megnevezés</th>
             <th>Mennyiség</th>
             <th>Egységár</th>
         </tr>
        </thead>
        <tbody>
             @foreach (var wp in Model.WorkProcesses)
             {
                 @foreach (var m in wp.Materials)
                 {
                     <tr>
                         <td>@m.Name</td>
                         <td>@m.Quantity</td>
                         <td>@m.Price</td>
                     </tr>
                 }
             }
        </tbody>
     </table>
     }

    @if (Model.WorkProcesses.Any())
    {
        
    <hr />
    <div class="alert alert-info text-center">
        <h5>Fizetendő végösszeg: @Model.TotalAmount.ToString("C0")</h5>
    </div>
        @if (!Model.IsOpen)
        {
            <button type="button" id="printButton" class="btn btn-lg text-dark fw-bold mt-3 bg-warning icon-link-hover" onclick="window.print()" title="Nyomtatás">
                Nyomtatás
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-printer-fill" viewBox="0 0 16 16">
                    <path d="M5 1a2 2 0 0 0-2 2v1h10V3a2 2 0 0 0-2-2zm6 8H5a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1" />
                    <path d="M0 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-1v-2a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v2H2a2 2 0 0 1-2-2zm2.5 1a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1" />
                </svg>
            </button>
        }
    }

    @if (!User.IsInRole("Mechanic"))
    {
    <div >
            @if (Model.IsOpen)
            {
                <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-primary">
                    Módosítás
                </a>
                <button type="button" class="btn btn-danger " data-bs-toggle="modal" data-bs-target="#closeModal">
                    Munkalap lezárása
                </button>
            }
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('print') === 'true') {
            const printBtn = document.getElementById('printButton');
            if (printBtn) {
                printBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
                setTimeout(() => {
                    printBtn.click();
                }, 800);
            }
        }
    });
</script>

<a asp-action="Index">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
    </svg>
</a>

    <div class="modal fade" id="closeModal" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-info">
                <div class="modal-header">
                    <h5 class="modal-title">Munkalap véglegesítése - @Model.Title</h5>
                </div>
                <form asp-action="Close" method="post">
                    <input type="hidden" asp-for="ID" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="paymentMethod" class="form-label fw-bold">Fizetési mód kiválasztása:</label>
                            <select name="paymentMethod" id="paymentMethod" class="form-select border-info" required>
                                <option value="">-- Kérjük, válasszon --</option>
                                <option value="Készpénz">Készpénz</option>
                                <option value="Bankkártya">Bankkártya</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <h5>
                                Fizetendő végösszeg:
                                <span class="fw-bold">@Model.TotalAmount.ToString("C0")</span>
                            </h5>
                        </div>
                
                        <div class="alert alert-warning small">
                            <span>Lezárás után a munkalap nem módosítható!</span>
                        </div>
                    </div>
                    <div class="modal-footer d-flex justify-content-center">
                        <button type="submit" class="btn btn-danger">Lezárás</button>
                    </div>
                </form>
            </div>
        </div>
    </div>