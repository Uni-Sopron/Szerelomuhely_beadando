@model SzereloMuhely.Models.WorkSheet

@{
    ViewData["Title"] = "Részletek";
}

<h1>Részletek</h1>
<hr />
<div class="d-flex flex-column align-items-center">
    <h4>Munkalap</h4>
    <dl class="row text-center">
        <dt class = "col-sm-6">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-6">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class = "col-sm-6">
            @Html.DisplayNameFor(model => model.IsOpen)
        </dt>
        <dd class = "col-sm-6">
            @Html.DisplayFor(model => model.IsOpen)
        </dd>
        <dt class = "col-sm-6">
            @Html.DisplayNameFor(model => model.PaymentMethod)
        </dt>
        <dd class = "col-sm-6">
            @Html.DisplayFor(model => model.PaymentMethod)
        </dd>
    </dl>
    <h3>Munkafolyamatok</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Megnevezés</th>
                <th>Munkadíj</th>
                <th>Anyag + Alkatrész</th>
                <th>Összesen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wp in Model.WorkProcesses)
            {
                <tr>
                    <td>@wp.Name</td>
                    <td>@wp.Price.ToString("C0")</td>
                    <td>
                        @((wp.Materials.Sum(m => m.Price * m.Quantity) +
                           wp.Parts.Sum(p => p.Price * p.Quantity)).ToString("C0"))
                    </td>
                    <td><strong>@((wp.Price + wp.Materials.Sum(m => m.Price * m.Quantity) + wp.Parts.Sum(p => p.Price * p.Quantity)).ToString("C0"))</strong></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="alert alert-info">
        <h4>Fizetendő végösszeg: @Model.TotalAmount.ToString("C0")</h4>
    </div>
    @if (!User.IsInRole("Mechanic"))
    {
    <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-primary">
        Módosítás
    </a>
    }
</div>
    <a asp-action="Index">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
        </svg>
    </a>