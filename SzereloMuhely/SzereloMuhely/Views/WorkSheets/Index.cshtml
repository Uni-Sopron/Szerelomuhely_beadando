@model IEnumerable<SzereloMuhely.Models.WorkSheet>

@{
    ViewData["Title"] = "Munkalapok";
}

<h1>Munkalapok</h1>
@if (!User.IsInRole("Mechanic"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-plus-fill" viewBox="0 0 16 16">
                <path d="M9.293 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.707A1 1 0 0 0 13.707 4L10 .293A1 1 0 0 0 9.293 0M9.5 3.5v-2l3 3h-2a1 1 0 0 1-1-1M8.5 7v1.5H10a.5.5 0 0 1 0 1H8.5V11a.5.5 0 0 1-1 0V9.5H6a.5.5 0 0 1 0-1h1.5V7a.5.5 0 0 1 1 0" />
            </svg>
            Új hozzáadása
        </a>
    </p>    
}

<table class="table table-hover">
    <thead>
        <tr>
            <th>Munkalap címe / Rendszám</th>
            @if (!User.IsInRole("Mechanic")) {
            <th>Szerelő</th>
            <th>Állapot</th>
            }
            <th>Létrehozva</th>
            @if (User.IsInRole("Admin"))
            {
                <th>@Html.DisplayNameFor(model => model.Recruiter)</th>
            }
            <th>Műveletek</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.IsOpen ? "" : "table-secondary text-muted")">
                <td>
                    <strong>@Html.DisplayFor(modelItem => item.Title)</strong>
                
                    @if (item.Vehicle != null)
                    {
                        <span class="badge bg-warning text-dark ms-2">
                            @item.Vehicle.LicensePlate
                        </span>
                    }
                </td>
                @if (!User.IsInRole("Mechanic"))
                {
                    <td>
                        @Html.DisplayFor(modelItem => item.Mechanic.UserName)
                    </td>
                    <td>
                        @if (item.IsOpen)
                        {
                            <span class="text-success">Nyitott</span>
                        }
                        else
                        {
                            <span class="text-secondary">Lezárt</span>
                        }
                    </td>
                }
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedAt)
                </td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        @Html.DisplayFor(modelItem => item.Recruiter.UserName)
                    </td>
                }
                <td class="d-flex justify-content-center gap-2">
                    <a asp-action="Details" asp-route-id="@item.ID">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0" />
                            <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7" />
                        </svg>
                    </a>
                    @if (!User.IsInRole("Mechanic") && item.IsOpen)
                    {
                        <a asp-action="Edit" asp-route-id="@item.ID">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pen-fill" viewBox="0 0 16 16">
                                <path d="m13.498.795.149-.149a1.207 1.207 0 1 1 1.707 1.708l-.149.148a1.5 1.5 0 0 1-.059 2.059L4.854 14.854a.5.5 0 0 1-.233.131l-4 1a.5.5 0 0 1-.606-.606l1-4a.5.5 0 0 1 .131-.232l9.642-9.642a.5.5 0 0 0-.642.056L6.854 4.854a.5.5 0 1 1-.708-.708L9.44.854A1.5 1.5 0 0 1 11.5.796a1.5 1.5 0 0 1 1.998-.001" />
                            </svg>
                        </a>
                    }
                    @if (!User.IsInRole("Mechanic"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.ID" class="text-danger">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash3-fill" viewBox="0 0 16 16">
                                <path d="M11 1.5v1h3.5a.5.5 0 0 1 0 1h-.538l-.853 10.66A2 2 0 0 1 11.115 16h-6.23a2 2 0 0 1-1.994-1.84L2.038 3.5H1.5a.5.5 0 0 1 0-1H5v-1A1.5 1.5 0 0 1 6.5 0h3A1.5 1.5 0 0 1 11 1.5m-5 0v1h4v-1a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5M4.5 5.029l.5 8.5a.5.5 0 1 0 .998-.06l-.5-8.5a.5.5 0 1 0-.998.06m6.53-.528a.5.5 0 0 0-.528.47l-.5 8.5a.5.5 0 0 0 .998.058l.5-8.5a.5.5 0 0 0-.47-.528M8 4.5a.5.5 0 0 0-.5.5v8.5a.5.5 0 0 0 1 0V5a.5.5 0 0 0-.5-.5" />
                            </svg>
                        </a>
                    }
                    @if (item.IsOpen && User.IsInRole("Recruiter") || item.IsOpen && User.IsInRole("Admin"))
                    {
                        <button type="button" class="btn btn-link text-success p-0"
                                data-bs-toggle="modal" data-bs-target="#closeModal-@item.ID" title="Lezárás">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-zip-fill" viewBox="0 0 16 16">
                                <path d="M5.5 9.438V8.5h1v.938a1 1 0 0 0 .03.243l.4 1.598-.93.62-.93-.62.4-1.598a1 1 0 0 0 .03-.243" />
                                <path d="M9.293 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.707A1 1 0 0 0 13.707 4L10 .293A1 1 0 0 0 9.293 0M9.5 3.5v-2l3 3h-2a1 1 0 0 1-1-1m-4-.5V2h-1V1H6v1h1v1H6v1h1v1H6v1h1v1H5.5V6h-1V5h1V4h-1V3zm0 4.5h1a1 1 0 0 1 1 1v.938l.4 1.599a1 1 0 0 1-.416 1.074l-.93.62a1 1 0 0 1-1.109 0l-.93-.62a1 1 0 0 1-.415-1.074l.4-1.599V8.5a1 1 0 0 1 1-1" />
                            </svg>
                        </button>
                    }
                </td>
            </tr>
            <div class="modal fade" id="closeModal-@item.ID" role="dialog">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-info">
                        <div class="modal-header">
                            <h5 class="modal-title">Munkalap véglegesítése - @item.Title</h5>
                        </div>
                        <form asp-action="Close" method="post">
                            <input type="hidden" name="id" value="@item.ID" />
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label for="paymentMethod-@item.ID" class="form-label fw-bold">Fizetési mód kiválasztása:</label>
                                    <select name="paymentMethod" id="paymentMethod-@item.ID" class="form-select border-info" required>
                                        <option value="">-- Kérjük, válasszon --</option>
                                        <option value="Készpénz">Készpénz</option>
                                        <option value="Bankkártya">Bankkártya</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <h5>
                                        Fizetendő végösszeg:
                                        <span class="fw-bold">@item.TotalAmount.ToString("C0")</span>
                                    </h5>
                                </div>
                
                                <div class="alert alert-warning small">
                                    <span>Lezárás után a munkalap nem módosítható!</span>
                                </div>
                            </div>
                            <div class="modal-footer d-flex justify-content-center">
                                <button type="submit" class="btn btn-danger">Lezárás</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </tbody>
</table>


