@model IEnumerable<SzereloMuhely.Models.WorkSheet>

@{
    ViewData["Title"] = "Munkalapok";
}

<h1>Munkalapok</h1>

<p>
    <a asp-action="Create">Új hozzáadása</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MechanicID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentMethod)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Mechanic.UserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaymentMethod)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ID">Módosítás</a> |
                <a asp-action="Details" asp-route-id="@item.ID">Részletek</a> |
                <a asp-action="Delete" asp-route-id="@item.ID">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
